{% set mainFormAttributes = {enctype: "multipart/form-data"} %}

{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% macro uploadFile(name) %}
    <input type="file" name="{{ name }}" accept=".csv,.tsv,.txt,text/csv">
{% endmacro %}

{% block actionButton %}
    {% if fullPageForm %}
        <input type="submit" class="btn submit" value="{{ 'Import' | t('translations-admin') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <p class="warning">{{ "The first column must be the key, followed by a column for each language with the language ID as the header (e.g. fr-CA). It should follow the same format as the exported CSV from the export section." | t('translations-admin')  }}</p>

    {{ actionInput('translations-admin/import/import') }}

    {# The category stays selected after an import, or after an import that failed #}
    {{ forms.selectField({
        first: true,
        label: "Category" | t('translations-admin'),
        instructions: "Choose which category to import your translations" | t('translations-admin'),
        id: 'category',
        name: 'category',
        value: craft.app.request.getParam('category') ?? '',
        options: categories
    }) }}

    {{ forms.field({
        label: "Upload your CSV file" | t('translations-admin'),
        instructions: "One column for the key and one column for each language is needed" | t('translations-admin')
    }, _self.uploadFile('file')) }}
{% endblock %}
