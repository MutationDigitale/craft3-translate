{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block actionButton %}
    {% if not readOnly %}
        <button type="submit" class="btn submit">{{ 'Save' | t('translations-admin') }}</button>
    {% endif %}
{% endblock %}

{% block content %}

    {% if not readOnly %}
        {{ actionInput('translations-admin/settings/save') }}
        {{ redirectInput("translations-admin/plugin-settings") }}
    {% endif %}

    {% namespace "settings" %}

        {{ forms.textField({
            first: true,
            label: "Plugin Name" | t('translations-admin'),
            instructions: "How the plugin should be named in the CP" | t('translations-admin'),
            id: 'pluginName',
            name: 'pluginName',
            value: settings.pluginName,
            required: true,
            errors: settings.getErrors('pluginName'),
            disabled: readOnly
        }) }}

        {{ forms.selectizeField({
            label: "Source Language"|t('app'),
            instructions: "By default, the source language is set to the primary site language, but you can override it here." | t('translations-admin'),
            id: 'sourceLanguage',
            name: 'sourceLanguage',
            value: settings.sourceLanguage,
            options: [{
                label: "Primary site language ({language})" | t('translations-admin', {language: craft.app.sites.primarySite.language}),
                value: '',
            }]|merge(craft.cp.getLanguageOptions(true)),
            disabled: readOnly
        }) }}

        {{ forms.editableTableField({
            label: "Categories" | t("translations-admin"),
            instructions: "Choose the source message categories you want to have in your database and control panel. Don't add the categories of Craft and plugins (e.g. `app`), the control panel would lose its own translations." | t("translations-admin"),
            id: 'categories',
            name: 'categories',
            required: true,
            allowAdd: true,
            allowReorder: true,
            allowDelete: true,
            defaultValues: {
                category: "",
            },
            cols: {
                category: {
                    heading: "Category" | t("translations-admin"),
                    type: "singleline",
                    width: "100%",
                    code: true,
                },
            },
            rows: collect(settings.categories).flatten().map(c => {category: c}),
            errors: settings.getErrors("categories"),
            static: readOnly
        }) }}

        {{ forms.lightswitchField({
            label: "Add missing translations" | t("translations-admin"),
            instructions: "Controls whether missing translations are automatically added to the database when a page is visited." | t("translations-admin"),
            id: "addMissingTranslations",
            name: "addMissingTranslations",
            on: settings.addMissingTranslations,
            errors: settings.getErrors("addMissingTranslations"),
            disabled: readOnly
        }) }}

        {{ forms.lightswitchField({
            label: "Add missing translations for site request only" | t("translations-admin"),
            instructions: "Controls whether missing translations are only added when the request is from the site." | t("translations-admin"),
            id: "addMissingSiteRequestOnly",
            name: "addMissingSiteRequestOnly",
            on: settings.addMissingSiteRequestOnly,
            errors: settings.getErrors("addMissingSiteRequestOnly"),
            disabled: readOnly
        }) }}

        {{ forms.lightswitchField({
            label: "Add missing translations from templates only" | t("translations-admin"),
            instructions: "Controls whether missing translations are only added when they are translated in a template with the `t` filter. When disabled, the messages translated in PHP code are also added, including the names Craft translates itself (e.g. sites, sections and fields)." | t("translations-admin"),
            id: "addMissingFromTemplatesOnly",
            name: "addMissingFromTemplatesOnly",
            on: settings.addMissingFromTemplatesOnly,
            errors: settings.getErrors("addMissingFromTemplatesOnly"),
            disabled: readOnly
        }) }}

        {{ forms.lightswitchField({
            label: "Enable caching" | t("translations-admin"),
            instructions: "Controls whether the translations are cached. The cache is cleared automatically when translations are changed with the plugin. If they are changed another way (e.g. by importing a database), clear the data caches." | t("translations-admin"),
            id: "enableCaching",
            name: "enableCaching",
            on: settings.enableCaching,
            errors: settings.getErrors("enableCaching"),
            disabled: readOnly
        }) }}

        {{ forms.editableTableField({
            label: "Excluded messages" | t("translations-admin"),
            instructions: "Messages that should not be added to the database, identified by a part of the string (basic matching, no regex)" | t("translations-admin"),
            id: 'excludedMessages',
            name: 'excludedMessages',
            required: false,
            allowAdd: true,
            allowReorder: true,
            allowDelete: true,
            defaultValues: {
                message: "",
            },
            cols: {
                message: {
                    heading: "Excluded message" | t("translations-admin"),
                    type: "singleline",
                    width: "100%",
                    code: true,
                },
            },
            rows: settings.excludedMessages ? collect(settings.excludedMessages).flatten().map(m => {message: m}) : [],
            errors: settings.getErrors("excludedMessages"),
            static: readOnly
        }) }}

    {% endnamespace %}
{% endblock %}
