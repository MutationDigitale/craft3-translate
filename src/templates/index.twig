{% extends "_layouts/cp" %}

{% do view.registerTranslations('translations-admin', [
    "Saving",
    "Save",
    "translations",
    "Translations saved",
    "Translations not saved",
    "Translation added",
    "Translation not added",
    "{count, plural, =1{Translation deleted} other{# translations deleted}}",
    "{count, plural, =1{Translation not deleted} other{Translations not deleted}}",
    "Add",
    "Delete",
    "Key",
    "Message",
    "All",
    "Empty in any displayed language",
    "Empty in {language}",
    "Date Created",
    "Columns",
    "Export",
    "Select",
    "Select all",
    "Filter: {filter}",
    "Search",
    "of",
    "First Page",
    "Previous Page",
    "Next Page",
    "Last Page",
    "Copy translations",
    "Paste translations",
    "Translations copied",
    "Translations pasted",
    "Translations pasted, except {count, plural, =1{one message} other{# messages}} already in the category.",
    "Translations not pasted",
    "Translations not pasted, the messages are already in the category.",
    "Translations could not be loaded",
    "Translations could not be exported",
    "Are you sure you want to delete {count, plural, =1{the selected translation} other{the # selected translations}}?",
    "You have unsaved changes. Are you sure you want to leave?"
]) %}

{% block actionButton %}
  {% if currentUser.can('saveTranslations') %}
    <save-translations></save-translations>
  {% endif %}
{% endblock %}

{% block sidebar %}
    {% if categories|length > 1 %}
        <translations-menu :categories="{{ categories | json_encode }}"></translations-menu>
    {% endif %}
{% endblock %}

{% block toolbar %}
    <translations-toolbar
      :add-permission="{{ currentUser.can('addTranslations')|json_encode }}"></translations-toolbar>
{% endblock %}

{% block content %}
    <div class="main">
        <translations-list current-category="{{ category }}"
          :save-permission="{{ currentUser.can('saveTranslations')|json_encode }}"></translations-list>
    </div>
{% endblock %}

{% block footer %}
    <translations-footer
      :add-permission="{{ currentUser.can('addTranslations')|json_encode }}"
      :delete-permission="{{ currentUser.can('deleteTranslations')|json_encode }}"
      :export-permission="{{ currentUser.can('exportTranslations')|json_encode }}"></translations-footer>
{% endblock %}
