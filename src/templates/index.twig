{% extends "_layouts/cp" %}

{% do view.registerTranslations('translations-admin', [
    "Saving",
    "Save",
    "translations",
    "Translations saved",
    "Translations not saved",
    "Translation added",
    "Translation not added",
    "Translation deleted",
    "Translation not deleted",
    "Add",
    "Delete",
    "Key",
    "Message",
    "All",
    "Empty",
    "Date Created",
    "Columns",
    "Export",
    "Select",
    "Search",
    "of",
    "First Page",
    "Previous Page",
    "Next Page",
    "Last Page",
    "Copy translations",
    "Paste translations",
    "Translations copied",
    "Translations pasted",
    "Translations pasted, except {count, plural, =1{one message} other{# messages}} already in the category.",
    "Translations not pasted",
    "Translations not pasted, the messages are already in the category.",
    "Translations could not be loaded",
    "Translations could not be exported",
    "Some messages were deleted in the meantime, their translations were not saved.",
    "Are you sure you want to delete {count, plural, =1{the selected translation} other{the # selected translations}}?",
    "You have unsaved changes. Are you sure you want to leave?"
]) %}

{% block actionButton %}
  {% if craft.app.user.checkPermission('saveTranslations') %}
    <save-translations></save-translations>
  {% endif %}
{% endblock %}

{% block sidebar %}
    {% if categories|length > 1 %}
        <translations-menu :categories="{{ categories | json_encode }}"></translations-menu>
    {% endif %}
{% endblock %}

{% block toolbar %}
    <translations-toolbar
      :add-permission="{{ craft.app.user.checkPermission('addTranslations') ? 'true' : 'false' }}"></translations-toolbar>
{% endblock %}

{% block content %}
    <div class="main">
        <translations-list current-category="{{ category }}"
          :save-permission="{{ craft.app.user.checkPermission('saveTranslations') ? 'true' : 'false' }}"></translations-list>
    </div>
{% endblock %}

{% block footer %}
    <translations-footer
      :add-permission="{{ craft.app.user.checkPermission('addTranslations') ? 'true' : 'false' }}"
      :delete-permission="{{ craft.app.user.checkPermission('deleteTranslations') ? 'true' : 'false' }}"
      :export-permission="{{ craft.app.user.checkPermission('exportTranslations') ? 'true' : 'false' }}"></translations-footer>
{% endblock %}

{% block foot %}
    <script>
    window.csrfTokenName = "{{ craft.app.config.general.csrfTokenName|e('js') }}";
    window.csrfTokenValue = "{{ craft.app.request.csrfToken|e('js') }}";
    </script>
{% endblock %}
