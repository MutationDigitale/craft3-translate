# Copy to tests/.env when not using DDEV (DDEV already sets these variables, see .ddev/config.yaml)
# The tests empty this database, don't use a database you care about!
CRAFT_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=translations_tests"
# CRAFT_DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=translations_tests"
CRAFT_DB_USER="root"
CRAFT_DB_PASSWORD="root"
CRAFT_DB_SCHEMA="public"
CRAFT_DB_TABLE_PREFIX=""
CRAFT_SECURITY_KEY="translations-admin-tests"
